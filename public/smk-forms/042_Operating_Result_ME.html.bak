<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>042 Operating Result Main Engine</title><style>*{box-sizing:border-box}body{margin:0;background:#e5e7eb;font-family:Arial}.p{max-width:1200px;margin:18px auto;background:#fff;padding:18px}.tools{text-align:right}.btn{border:0;border-radius:6px;padding:9px;background:#1769d2;color:#fff;font-weight:bold}.head,.sec{border:2px solid;padding:8px;margin-top:9px}.top{display:grid;grid-template-columns:24% 53% 23%;border-bottom:2px solid;min-height:75px}.co,.ttl{font-weight:bold;font-size:12px}.ttl{text-align:center}.st{display:flex;flex-direction:column;align-items:flex-end;gap:8px;padding-right:14px;font-size:10px}.code{display:flex;border:1px solid}.code span{padding:5px 9px}.code span+span{border-left:1px solid}.grid{display:grid;grid-template-columns:repeat(auto-fit, minmax(350px, 1fr));gap:7px 18px;margin-top:8px}.f{display:flex;gap:6px;font-size:9px;font-weight:bold}.f input,.f select{flex:1;min-width:0;border:0;border-bottom:1px solid;background:#fff}.wide{grid-column:1/-1}.ship{margin:10px 0 4px}.ship label{width:100%}.sec h3{font-size:10px;margin:0 0 8px;background:#eee;padding:5px}.tbl{width:100%;border-collapse:collapse;margin-top:6px;font-size:8px}.tbl th,.tbl td{border:1px solid;padding:3px;vertical-align:middle;text-align:center}.tbl th{background:#f3f4f6}.sig{text-align:center;border:2px solid;margin-top:9px;padding:8px;font-size:9px}@media screen and (max-width:700px){.p{margin:0;padding:10px}.top{display:flex;flex-direction:column}.co,.ttl,.st{width:100%;text-align:center}.st{align-items:center}.tbl{font-size:7px}}@media print{.no-print{display:none!important}}</style></head><body><main class="p"><div class="tools no-print"><button class="btn" onclick="print()">Print / Simpan PDF</button></div><header class="head"><div class="top"><div class="co">PT MENTARI MAS MULTIMODA</div><div class="ttl">042<br>HASIL PENGOPERASIAN MESIN INDUK<br>OPERATING RESULT MAIN ENGINE</div><div class="st"><div class="code"><span>CS</span></div></div></div><div class="grid"><label class="f">Vessel:<input></label><label class="f">Date:<input class="date" placeholder="DD-MM-YYYY"></label><label class="f">ME No.:<input></label></div></header><section class="sec"><h3>Main Engine Information</h3><table class="tbl"><tr><th>Main Engine Brand / Type / Serial No.</th><td colspan="3"><input style="width:100%"></td></tr><tr><th>Total Running hours / Hours this month</th><td><input style="width:100%"></td><th>Running hours since last check :</th><td><input style="width:100%"></td></tr><tr><th>Turbo blower this month / Since last overhaul :</th><td><input style="width:100%"></td><th>Valve clearence - Date of last check / Remarks :</th><td colspan="2"><input style="width:100%"></td></tr><tr><th>Cams and rollers - Date of last check / Remarks :</th><td colspan="3"><input style="width:100%"></td></tr><tr><th>Reduction Gear wheels - Date of last check / Remarks :</th><td colspan="3"><input style="width:100%"></td></tr><tr><th>TC oil change / TC air filter hrs :</th><td><input style="width:100%"></td><th>Vibration damper - Date of last check / Total Running hours</th><td colspan="2"><input style="width:100%"></td></tr><tr><th>Air cooler cleaned - Date :</th><td><input style="width:100%"></td><th>Coupling engine/gear - Date of last check / Total running hours :</th><td><input style="width:100%"></td></tr><tr><th>Governor oil change hrs / Since Last Overhaul / Total running hrs:</th><td><input style="width:100%"></td><th>Graviner oil detector - Date of last check / Remarks :</th><td><input style="width:100%"></td></tr><tr><th>Crankcase inspection - Date of last check / Remarks :</th><td><input style="width:100%"></td><th>Foundation Bolts / tie rods - Date of last check / Remarks :</th><td><input style="width:100%"></td></tr><tr><th>Air Valves changed - Date / Remarks :</th><td><input style="width:100%"></td></tr></table></section><section class="sec"><h3>Cylinder Components (Units counted forward from)</h3><table class="tbl"><thead><tr><th rowspan="2">Component</th><th colspan="6">Cyl ME No.</th></tr><tr><th>1</th><th>2</th><th>3</th><th>4</th><th>5</th><th>6</th></tr></thead><tbody><tr><td>Cyl cover since last overhaul</td><td><input style="width:100%"></td><td><input style="width:100%"></td><td><input style="width:100%"></td><td><input style="width:100%"></td><td><input style="width:100%"></td><td><input style="width:100%"></td></tr><tr><td>Cyl. Liner last overh.</td><td><input style="width:100%"></td><td><input style="width:100%"></td><td><input style="width:100%"></td><td><input style="width:100%"></td><td><input style="width:100%"></td><td><input style="width:100%"></td></tr><tr><td>Cyl. Liner total</td><td><input style="width:100%"></td><td><input style="width:100%"></td><td><input style="width:100%"></td><td><input style="width:100%"></td><td><input style="width:100%"></td><td><input style="width:100%"></td></tr><tr><td>Piston (skirt) last overh.</td><td><input style="width:100%"></td><td><input style="width:100%"></td><td><input style="width:100%"></td><td><input style="width:100%"></td><td><input style="width:100%"></td><td><input style="width:100%"></td></tr><tr><td>Piston (skirt) total</td><td><input style="width:100%"></td><td><input style="width:100%"></td><td><input style="width:100%"></td><td><input style="width:100%"></td><td><input style="width:100%"></td><td><input style="width:100%"></td></tr></tbody></table></section><section class="sec"><h3>Remarks</h3><p><strong>Remark:</strong></p><textarea style="width:100%;height:80px;border:1px solid"></textarea></section><section class="sig"><b>Prepared by / Dibuat oleh,</b><div class="space"><label class="btn no-print">+ Add TTD<input id="sigup1" class="hidden" type="file" accept="image/*"></label><div id="pv1" class="pv hidden"><img><button class="x no-print" onclick="clearSig('pv1','sigup1')">×</button></div></div><input class="nm"><div class="grid"><label class="f">Name:</label><label class="f">Date:<input class="date" placeholder="DD-MM-YYYY"></label><label class="f wide">Time:<input class="time" placeholder="HH:MM"></label></div></section><section class="sig"><b>Checked & Approved by / Diperiksa & Disetujui oleh,</b><div class="space"><label class="btn no-print">+ Add TTD<input id="sigup2" class="hidden" type="file" accept="image/*"></label><div id="pv2" class="pv hidden"><img><button class="x no-print" onclick="clearSig('pv2','sigup2')">×</button></div></div><input class="nm"><div class="grid"><label class="f">Name:</label><label class="f">Date:<input class="date" placeholder="DD-MM-YYYY"></label><label class="f wide">Time:<input class="time" placeholder="HH:MM"></label></div></section><section class="sig"><b>Knowledge by / Mengetahui,</b><div class="space"><label class="btn no-print">+ Add TTD<input id="sigup3" class="hidden" type="file" accept="image/*"></label><div id="pv3" class="pv hidden"><img><button class="x no-print" onclick="clearSig('pv3','sigup3')">×</button></div></div><input class="nm"><div class="grid"><label class="f">Name:</label><label class="f">Date:<input class="date" placeholder="DD-MM-YYYY"></label><label class="f wide">Time:<input class="time" placeholder="HH:MM"></label></div></section></main><script>function clearSig(pv,up){const box=document.getElementById(pv);const btn=document.getElementById(up);box.querySelector('img').src='';btn.value='';box.classList.add('hidden');box.style.display='none';btn.parentElement.classList.remove('hidden')};document.querySelectorAll('.date').forEach(x=>x.oninput=e=>{let v=e.target.value.replace(/\\D/g,'').slice(0,8);if(v.length>2)v=v.slice(0,2)+'-'+v.slice(2);if(v.length>5)v=v.slice(0,5)+'-'+v.slice(5);e.target.value=v});document.querySelectorAll('.time').forEach(x=>x.oninput=e=>{let v=e.target.value.replace(/\\D/g,'').slice(0,4);if(v.length>2)v=v.slice(0,2)+':'+v.slice(2);e.target.value=v});document.querySelectorAll('input[type=radio]').forEach(r=>{r.onpointerdown=()=>r.dataset.w=r.checked?'1':'0';r.onclick=()=>{if(r.dataset.w==='1')r.checked=false}});const initSig=(up,pv)=>{const btn=document.getElementById(up);const box=document.getElementById(pv);btn.onchange=e=>{let f=e.target.files[0];if(!f)return;let rd=new FileReader;rd.onload=z=>{box.querySelector('img').src=z.target.result;btn.parentElement.classList.add('hidden');box.classList.remove('hidden');box.style.display='flex'};rd.readAsDataURL(f)}};initSig('sigup1','pv1');initSig('sigup2','pv2');initSig('sigup3','pv3');</script></body></html>